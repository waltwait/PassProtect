<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        本 app 其餘部分完全離線；這是唯一用到網路的地方——編輯畫面的
        「搜尋網址」功能嵌了一個 WebView 給使用者自己瀏覽找網址，密碼/提示
        內容本身不會經過這個管道，也沒有任何背景網路存取。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PassProtect"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PassProtect"
        android:allowBackup="false">
        <!--
            adjustResize 是必要的，不只是錦上添花：沒有它，系統預設用舊式的
            「整個視窗跟著鍵盤平移」（pan）行為，跟 Compose 畫面裡各個輸入框
            自己用的 Modifier.imePadding() 互搶——兩邊都在動、算出來的位置對不
            齊，鍵盤跳出來還是會蓋到一部分輸入框。設成 adjustResize 讓系統把
            「鍵盤佔用多少高度」正確地透過 WindowInsets 交給 Compose 處理，
            兩邊才不會打架。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
